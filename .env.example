# Server Configuration
PORT=8000
HOST=127.0.0.1
DATABASE_PATH=smart_resume_screener.db

# LLM Configuration (Optional - Smart Screener falls back to intelligent semantic matching if not provided)
# Supported Providers: "gemini", "openai", or "custom"
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
